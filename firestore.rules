rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSystemAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/systemAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/systemAdmins/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/systemAdmins/$(request.auth.uid)).data.role in ["owner", "admin"];
    }
    function walletPath(uid) {
      return /databases/$(database)/documents/walletAccounts/$(uid);
    }
    function operationPath(operationId) {
      return /databases/$(database)/documents/walletOperations/$(operationId);
    }
    function validAmount(amount) {
      return amount is number && amount > 0 && amount <= 50000;
    }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isSystemAdmin();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Wallet accounts are private. A new account receives one fixed fictitious
    // welcome credit; clients cannot choose a larger starting balance.
    match /walletAccounts/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isSystemAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.balance == 50000
        && request.resource.data.cashbackTotal == 0
        && request.resource.data.depositedTotal == 0
        && request.resource.data.alias is string
        && request.resource.data.cvu is string
        && request.resource.data.lastOperationId == "welcome";

      allow update: if (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.alias == resource.data.alias
        && request.resource.data.cvu == resource.data.cvu
        && changedOnly(["balance", "depositedTotal", "lastOperationId", "updatedAt"])
        && request.resource.data.lastOperationId is string
        && existsAfter(operationPath(request.resource.data.lastOperationId))
        && (
          (
            getAfter(operationPath(request.resource.data.lastOperationId)).data.kind == "DEPOSIT"
            && getAfter(operationPath(request.resource.data.lastOperationId)).data.senderUid == userId
            && request.resource.data.balance == resource.data.balance
              + getAfter(operationPath(request.resource.data.lastOperationId)).data.amount
            && request.resource.data.depositedTotal == resource.data.depositedTotal
              + getAfter(operationPath(request.resource.data.lastOperationId)).data.amount
          )
          ||
          (
            getAfter(operationPath(request.resource.data.lastOperationId)).data.kind in ["TRANSFER", "QR_PAYMENT"]
            && request.auth.uid == getAfter(operationPath(request.resource.data.lastOperationId)).data.senderUid
            && (
              (
                userId == getAfter(operationPath(request.resource.data.lastOperationId)).data.senderUid
                && request.resource.data.balance == resource.data.balance
                  - getAfter(operationPath(request.resource.data.lastOperationId)).data.amount
                && request.resource.data.depositedTotal == resource.data.depositedTotal
              )
              ||
              (
                userId == getAfter(operationPath(request.resource.data.lastOperationId)).data.recipientUid
                && request.resource.data.balance == resource.data.balance
                  + getAfter(operationPath(request.resource.data.lastOperationId)).data.amount
                && request.resource.data.depositedTotal == resource.data.depositedTotal
              )
            )
          )
        )
      ) || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.cvu == resource.data.cvu
        && request.resource.data.alias is string
        && request.resource.data.alias.matches('^[a-z0-9][a-z0-9._-]{2,29}$')
        && resource.data.alias != request.resource.data.alias
        && changedOnly(["alias", "updatedAt"])
        && existsAfter(/databases/$(database)/documents/walletDirectory/$(request.resource.data.alias))
        && getAfter(/databases/$(database)/documents/walletDirectory/$(request.resource.data.alias)).data.uid == userId
        && !existsAfter(/databases/$(database)/documents/walletDirectory/$(resource.data.alias))
      );

      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.operationId == transactionId
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.status == "APROBADA · DEMO"
          && (
            (
              transactionId == "welcome"
              && request.auth.uid == userId
              && request.resource.data.amount == 50000
              && getAfter(walletPath(userId)).data.balance == 50000
            )
            ||
            (
              existsAfter(operationPath(transactionId))
              && request.auth.uid == getAfter(operationPath(transactionId)).data.senderUid
              && (
                userId == getAfter(operationPath(transactionId)).data.senderUid
                || userId == getAfter(operationPath(transactionId)).data.recipientUid
              )
              && request.resource.data.amount == getAfter(operationPath(transactionId)).data.amount
            )
          );
        allow update, delete: if false;
      }
    }

    // Public lookup data contains only fictitious account identifiers.
    match /walletDirectory/{alias} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.alias == alias
        && request.resource.data.cvu is string;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.alias == alias
        && request.resource.data.cvu == resource.data.cvu;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // OMNI Oportunidades: job and local-service listings.
    // Listings are visible to signed-in users; only the publisher can edit or remove them.
    // Demo merchant ownership. The first authenticated account to activate a
    // store profile claims it for this sandbox; this is not real-world verification.
    match /merchantProfiles/{storeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.storeId == storeId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.storeName is string;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.storeId == resource.data.storeId;
      allow delete: if false;
    }

    // QR codes identify orders only. They never confirm payment.
    match /storeOrders/{orderId} {
      function merchantProfilePath() {
        return /databases/$(database)/documents/merchantProfiles/$(resource.data.storeId);
      }
      function validNextStatus() {
        return
          (resource.data.status == "RECIBIDO" && request.resource.data.status in ["ACEPTADO", "RECHAZADO"]) ||
          (resource.data.status == "ACEPTADO" && request.resource.data.status in ["EN_PREPARACION", "CANCELADO"]) ||
          (resource.data.status == "EN_PREPARACION" && request.resource.data.status in ["LISTO", "CANCELADO"]) ||
          (resource.data.status == "LISTO" && request.resource.data.status in ["EN_CAMINO", "ENTREGADO"]) ||
          (resource.data.status == "EN_CAMINO" && request.resource.data.status == "ENTREGADO");
      }
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.merchantUid is string
        && request.resource.data.merchantUid != request.auth.uid
        && request.resource.data.storeId is string
        && request.resource.data.status == "RECIBIDO"
        && request.resource.data.paymentStatus == "PENDIENTE"
        && request.resource.data.paymentMethod == "PAGO_AL_RETIRAR"
        && request.resource.data.fulfillmentType in ["RETIRO", "DELIVERY"]
        && (request.resource.data.fulfillmentType == "RETIRO"
          || (request.resource.data.deliveryAddress is string && request.resource.data.deliveryAddress.size() > 0))
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total <= 500000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.qrNonce is string
        && request.resource.data.qrNonce.size() >= 20
        && get(/databases/$(database)/documents/merchantProfiles/$(request.resource.data.storeId)).data.ownerUid
          == request.resource.data.merchantUid;
      // Queries must constrain customerUid or merchantUid to the signed-in user.
      // merchantUid is copied from the claimed merchant profile at order creation.
      allow read: if isSystemAdmin() || (signedIn()
        && (resource.data.customerUid == request.auth.uid
          || resource.data.merchantUid == request.auth.uid));
      allow update: if signedIn()
        && get(merchantProfilePath()).data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.total == resource.data.total
        && request.resource.data.qrNonce == resource.data.qrNonce
        && validNextStatus();
      allow delete: if false;
    }

    // OMNI Events: authenticated community calendar.
    match /omniEvents/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000
        && request.resource.data.location is string
        && request.resource.data.dateTime is string
        && request.resource.data.status == "PUBLISHED";
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /jobPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 3000
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.status == "ACTIVE";
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /jobApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postOwnerUid is string
        && request.resource.data.postOwnerUid != request.auth.uid
        && get(/databases/$(database)/documents/jobPosts/$(request.resource.data.postId)).data.ownerUid
          == request.resource.data.postOwnerUid;
      allow read: if isSystemAdmin() || (signedIn()
        && (applicationId.matches("^" + request.auth.uid + "_.*")
          || resource.data.applicantUid == request.auth.uid
          || resource.data.postOwnerUid == request.auth.uid));
      allow update: if signedIn()
        && resource.data.postOwnerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["RECIBIDA", "EN_REVISION", "ACEPTADA", "RECHAZADA"];
      allow delete: if signedIn() && resource.data.applicantUid == request.auth.uid;
    }

    // The operation record ties both balance changes together atomically.
    match /walletOperations/{operationId} {
      allow read: if isSystemAdmin() || (signedIn()
        && (resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid));

      allow create: if signedIn()
        && request.resource.data.operationId == operationId
        && request.resource.data.senderUid == request.auth.uid
        && validAmount(request.resource.data.amount)
        && (
          (
            request.resource.data.kind == "DEPOSIT"
            && request.resource.data.recipientUid == request.auth.uid
            && get(walletPath(request.auth.uid)).data.depositedTotal
              + request.resource.data.amount <= 150000
            && getAfter(walletPath(request.auth.uid)).data.balance
              == get(walletPath(request.auth.uid)).data.balance + request.resource.data.amount
            && getAfter(walletPath(request.auth.uid)).data.depositedTotal
              == get(walletPath(request.auth.uid)).data.depositedTotal + request.resource.data.amount
          )
          ||
          (
            request.resource.data.kind in ["TRANSFER", "QR_PAYMENT"]
            && request.resource.data.recipientUid is string
            && request.resource.data.recipientUid != request.auth.uid
            && get(walletPath(request.auth.uid)).data.balance >= request.resource.data.amount
            && getAfter(walletPath(request.auth.uid)).data.balance
              == get(walletPath(request.auth.uid)).data.balance - request.resource.data.amount
            && getAfter(walletPath(request.resource.data.recipientUid)).data.balance
              == get(walletPath(request.resource.data.recipientUid)).data.balance + request.resource.data.amount
          )
        );
      allow update, delete: if false;
    }

    // OMNI Admin: authorization documents are provisioned manually by the project owner.
    match /systemAdmins/{adminUid} {
      allow read: if signedIn() && request.auth.uid == adminUid;
      allow create, update, delete: if false;
    }

    match /adminConfig/{configId} {
      allow read, write: if isSystemAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if isSystemAdmin();
      allow create: if isSystemAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /moduleRegistry/{moduleId} {
      allow read, write: if isSystemAdmin();
    }

    match /betaInvitations/{invitationId} {
      allow read, write: if isSystemAdmin();
    }

    match /usageEvents/{eventId} {
      allow read: if isSystemAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.module is string
        && request.resource.data.event is string
        && request.resource.data.appVersion is string
        && request.resource.data.createdAt is timestamp
        && (!("eventId" in request.resource.data) || request.resource.data.eventId is string)
        && (!("platform" in request.resource.data) || request.resource.data.platform == "android")
        && (!("schemaVersion" in request.resource.data) || request.resource.data.schemaVersion is int)
        && (!("data" in request.resource.data) || (
          request.resource.data.data is map
          && request.resource.data.data.keys().hasOnly([
            "category", "source", "resultCount", "durationMs", "success",
            "itemType", "method", "flow", "surface", "destinationType",
            "screenName", "radiusBucket", "status",
            "operationId", "correlationId", "stage"
          ])
        ))
        && request.resource.data.keys().hasOnly([
          "uid", "module", "event", "appVersion", "createdAt", "campaignId",
          "sessionId", "eventId", "platform", "schemaVersion", "data"
        ]);
      allow update, delete: if false;
    }

    match /appFeedback/{feedbackId} {
      allow read: if isSystemAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
